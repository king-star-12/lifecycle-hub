# ---------------------------------------------------------------
# Clustral Water Intelligence — configuration
# Copy to .env.local. Never commit real credentials.
# Never prefix a secret with NEXT_PUBLIC_ — that ships it to the browser.
# ---------------------------------------------------------------

# --- Azure (provisioned via `az` CLI; no secrets pasted here) -------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=clustral-rg
AZURE_LOCATION=eastus

ADX_CLUSTER_URI=
ADX_DATABASE=clustral
ADT_INSTANCE_URL=
AZURE_STORAGE_CONNECTION_STRING=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Xano (application backend: auth, APIs, business logic) --------
XANO_INSTANCE_BASE_URL=
XANO_METADATA_TOKEN=
XANO_API_GROUP_BASE_URL=

# --- Nutrient DWS (inspection/maintenance PDF extraction) ----------
NUTRIENT_API_KEY=

# --- Querit.ai (research + page retrieval) -------------------------
QUERIT_API_KEY=

# --- SerpApi (live external context) -------------------------------
SERPAPI_API_KEY=

# --- Doctavian (operator-ready report generation) ------------------
DOCTAVIAN_API_KEY=

# --- Foxit (optional signed work orders) ---------------------------
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# --- Fallback LLM (used only if Azure AI is unavailable) -----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
